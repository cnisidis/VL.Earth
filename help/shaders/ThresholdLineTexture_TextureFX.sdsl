
[Category()]
[Summary("Returns a Thin Line")]
shader ThresholdLineTexture_TextureFX : TextureFX
{
    
    float2 Resolution = float2(3000, 300);
    
    [Color]
    float4 Background;
    [Color]
    float4 Color;

    float ThresholdValue = 0.5;
    bool ShowThreshold = true;

    stage override float4 Shading()
    {
        float2 uv = streams.TexCoord;
        float PixelHeight = 1/Resolution.y;

        
        float4 input = Texture0.Sample(Sampler0, uv) ;
        float4 ThresholdLine = float4(0,0,0,0);
        
     
            
        if(ShowThreshold)
        {
            if(uv.y >= 1- ThresholdValue && uv.y <= 1-ThresholdValue + PixelHeight)
            {
                ThresholdLine = Color;
            }
        }
        
        return input + ThresholdLine;;
    }
};

